import { useState } from "react";
import { motion } from "framer-motion";

const departments = [
  "Orange County Sheriffs Office",
  "Florida Highway Patrol",
  "Florida Police Department",
  "Civilian"
];

const pistols = [
  { name: "Pistol", price: 500 },
  { name: "Combat Pistol", price: 700 },
  { name: "AP Pistol", price: 1200 },
  { name: "Heavy Pistol", price: 1500 },
  { name: "Vintage Pistol", price: 1000 }
];

const assaultRifles = [
  { name: "Assault Rifle", price: 2500 },
  { name: "Carbine Rifle", price: 3500 },
  { name: "Advanced Rifle", price: 4000 },
  { name: "Special Carbine", price: 4200 },
  { name: "Bullpup Rifle", price: 3800 }
];

export default function CADSystem() {
  const [calls, setCalls] = useState({});
  const [newCall, setNewCall] = useState("");
  const [selectedDept, setSelectedDept] = useState(departments[0]);
  const [balance, setBalance] = useState(5000); // starting balance
  const [amount, setAmount] = useState("");
  const [transactions, setTransactions] = useState([]);
  const [inventory, setInventory] = useState([]);

  const addCall = () => {
    if (!newCall.trim()) return;
    const deptCalls = calls[selectedDept] || [];
    const updatedCalls = {
      ...calls,
      [selectedDept]: [...deptCalls, { id: Date.now(), text: newCall }]
    };
    setCalls(updatedCalls);
    setNewCall("");
  };

  const addMoney = () => {
    const value = parseFloat(amount);
    if (isNaN(value) || value <= 0) return;
    setBalance(balance + value);
    setTransactions([...transactions, { id: Date.now(), type: "Deposit", amount: value }]);
    setAmount("");
  };

  const subtractMoney = () => {
    const value = parseFloat(amount);
    if (isNaN(value) || value <= 0 || balance - value < 0) return;
    setBalance(balance - value);
    setTransactions([...transactions, { id: Date.now(), type: "Withdrawal", amount: value }]);
    setAmount("");
  };

  const buyItem = (item) => {
    if (balance < item.price) {
      alert("Not enough money!");
      return;
    }
    setBalance(balance - item.price);
    setInventory([...inventory, item]);
    setTransactions([...transactions, { id: Date.now(), type: `Bought ${item.name}`, amount: -item.price }]);
  };

  return (
    <div className="min-h-screen bg-gray-900 text-white p-6">
      <h1 className="text-3xl font-bold mb-6">FiveM CAD System</h1>

      {/* Money System */}
      <div className="mb-6 bg-gray-800 shadow-lg rounded-2xl p-4">
        <h2 className="text-xl font-semibold mb-4">Money System</h2>
        <p className="mb-4">Balance: <span className="font-bold text-green-400">${balance.toLocaleString()}</span></p>

        <div className="flex gap-2 mb-4">
          <input
            className="flex-1 px-2 py-1 rounded text-black"
            placeholder="Enter amount..."
            value={amount}
            onChange={(e) => setAmount(e.target.value)}
          />
          <button onClick={addMoney} className="px-3 py-1 bg-green-600 rounded-2xl">Deposit</button>
          <button onClick={subtractMoney} className="px-3 py-1 bg-red-600 rounded-2xl">Withdraw</button>
        </div>

        <div>
          <h3 className="text-lg font-semibold mb-2">Transaction Log</h3>
          <ul className="space-y-1">
            {transactions.map(tx => (
              <li key={tx.id} className="text-sm">
                [{tx.type}] ${tx.amount.toLocaleString()}
              </li>
            ))}
          </ul>
        </div>
      </div>

      {/* Gun Store */}
      <div className="mb-6 bg-gray-800 shadow-lg rounded-2xl p-4">
        <h2 className="text-xl font-semibold mb-4">Guns Store</h2>

        <h3 className="text-lg font-semibold mb-2">Pistols</h3>
        <div className="grid gap-2 mb-4">
          {pistols.map((gun) => (
            <div key={gun.name} className="flex justify-between items-center bg-gray-700 p-2 rounded-lg">
              <span>{gun.name} - ${gun.price}</span>
              <button onClick={() => buyItem(gun)} className="px-3 py-1 bg-blue-600 rounded-2xl">Buy</button>
            </div>
          ))}
        </div>

        <h3 className="text-lg font-semibold mb-2">Assault Rifles</h3>
        <div className="grid gap-2">
          {assaultRifles.map((gun) => (
            <div key={gun.name} className="flex justify-between items-center bg-gray-700 p-2 rounded-lg">
              <span>{gun.name} - ${gun.price}</span>
              <button onClick={() => buyItem(gun)} className="px-3 py-1 bg-blue-600 rounded-2xl">Buy</button>
            </div>
          ))}
        </div>

        <h3 className="text-lg font-semibold mt-6 mb-2">Your Inventory</h3>
        <ul className="space-y-1">
          {inventory.length === 0 ? (
            <li className="text-sm text-gray-400">No items purchased yet.</li>
          ) : (
            inventory.map((item, idx) => (
              <li key={idx} className="text-sm">{item.name}</li>
            ))
          )}
        </ul>
      </div>

      {/* Call System */}
      <div className="mb-6 bg-gray-800 shadow-lg rounded-2xl p-4">
        <h2 className="text-xl font-semibold mb-4">Create New Call</h2>
        <div className="flex flex-col gap-4">
          <div className="flex gap-2">
            <input
              className="flex-1 px-2 py-1 rounded text-black"
              placeholder="Enter call details..."
              value={newCall}
              onChange={(e) => setNewCall(e.target.value)}
            />
            <button onClick={addCall} className="px-3 py-1 bg-blue-600 rounded-2xl">Add</button>
          </div>

          <div className="flex gap-2 flex-wrap">
            {departments.map((dept) => (
              <button
                key={dept}
                onClick={() => setSelectedDept(dept)}
                className={`px-3 py-1 rounded-2xl ${selectedDept === dept ? "bg-blue-500" : "bg-gray-600"}`}
              >
                {dept}
              </button>
            ))}
          </div>
        </div>
      </div>

      <h2 className="text-2xl font-semibold mb-4">{selectedDept} Calls</h2>
      <div className="grid gap-4">
        {(calls[selectedDept] || []).map((call) => (
          <motion.div
            key={call.id}
            initial={{ opacity: 0, y: 10 }}
            animate={{ opacity: 1, y: 0 }}
          >
            <div className="bg-gray-800 shadow-md rounded-2xl p-4">
              <p>{call.text}</p>
            </div>
          </motion.div>
        ))}
      </div>
    </div>
  );
}
